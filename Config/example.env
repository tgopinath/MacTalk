# Copy to development.env / staging.env / production.env.
# These are PUBLIC Firebase web settings; database.rules.json protects the data.
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
AUTH_PAGE_URL=https://YOUR-GITHUB-USER.github.io/MacTalk/auth/
# Optional TURN relay for strict networks (leave empty for STUN only)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
